{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    { "identifier": "shell:allow-execute", "allow": [{ "name": "backend", "sidecar": true }] },
    "shell:allow-spawn"
  ]
}
